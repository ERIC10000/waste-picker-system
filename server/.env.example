# ---- Supabase -------------------------------------------------------
# Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ---- Server ---------------------------------------------------------
PORT=4000

# Domain used to turn a picker's phone number into a Supabase Auth email.
# Pickers log in with their PHONE, never with this address.
PHONE_EMAIL_DOMAIN=wastepickers.ke

# Storage bucket for profile photos (created by schema.sql)
PHOTO_BUCKET=picker-photos

# ---- Local seed command ---------------------------------------------
# Required by `npm run seed`; never reuse these values in production.
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=System Administrator
# Required only with `npm run seed -- --demo`.
SEED_PICKER_PASSWORD=
