# The Vercel CLI uploads the working directory, and it does not reliably honour
# .gitignore for dotfiles. Without this, dashboard/.env was shipped and Vite
# baked VITE_API_URL=http://localhost:4000 into the production bundle.
# Real values belong in the Vercel project's Environment Variables.
.env
.env.*
!.env.example
**/.env
**/.env.*

node_modules
dashboard/dist
.vercel
